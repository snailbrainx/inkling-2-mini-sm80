+                torch.tensor(kv_indptr, dtype=torch.int32),
+                torch.from_numpy(kv_indices_np),
+                torch.tensor(kv_last_page_len, dtype=torch.int32),
+                num_heads,
+                num_kv_heads,
+                head_dim,
+                page,
+                causal=True,
+                sm_scale=softmax_scale,
+                q_data_type=torch.bfloat16,
+                kv_data_type=fi_kv_dtype,
