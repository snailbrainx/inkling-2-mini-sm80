+        or pair.dtype != torch.bfloat16
+        or down.dtype != torch.bfloat16
+        or gain_forget.dtype != torch.bfloat16
+        or pair.ndim != 3
+        or not 0 < pair.shape[1] <= MAX_M
+        or pair.stride(-1) != 1
+        or down.stride(-1) != 1
+        or gain_forget.stride(-1) != 1
