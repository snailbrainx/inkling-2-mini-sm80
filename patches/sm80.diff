+        r,
+        k,
+        pair.stride(0),
+        pair.stride(1),
+        down.stride(0),
+        down.stride(1),
+        K_PER=k_per,
+        BN=16,
+        BK=64,
+        MP=16,
+        num_warps=warps,
+        num_stages=3,
+    )
+    out = torch.empty((s, m, n), device=pair.device, dtype=torch.float32)
+    _ctrl_gf_kernel[(triton.cdiv(n, bn_gf), s)](
+        part,
+        gain_forget,
+        out,
+        m,
+        n,
+        gain_forget.stride(0),
+        gain_forget.stride(1),
+        out.stride(0),
+        out.stride(1),
+        SPLITS=splits,
+        R=r,
+        BN=bn_gf,
+        MP=16,
+        num_warps=4,
+    )
+    return out
