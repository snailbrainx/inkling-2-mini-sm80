+    tl.store(
+        Out + token[:, None] * stride_out_t + head[:, None] * stride_out_h + offs_d[None, :],
+        o,
+        mask=row_valid[:, None],
+    )
+    tl.store(
+        Lse + head * stride_lse_h + token * stride_lse_t,
+        lse2 * 0.6931471805599453,
+        mask=row_valid,
+    )
