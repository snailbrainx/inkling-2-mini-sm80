+@triton.jit
+def _rel_attention_near_causal_kernel(
+    Q,
+    K,
+    V,
+    Rel,
+    BlockTable,
+    SeqLens,
+    CuSeqlensQ,
+    FarRowIdx,
+    FarOut,
+    FarLse,
+    Out,
+    Lse,
+    softmax_scale,
+    stride_q_t,
+    stride_q_h,
+    stride_kv_blk,
+    stride_kv_slot,
+    stride_kv_h,
+    stride_rel_t,
+    stride_bt,
+    stride_fo_t,
+    stride_fo_h,
+    stride_fl_t,
+    stride_fl_h,
+    stride_out_t,
+    stride_out_h,
+    stride_lse_h,
+    stride_lse_t,
+    H: tl.constexpr,
+    G: tl.constexpr,
+    D: tl.constexpr,
+    E: tl.constexpr,
+    PAGE: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    IS_U8_FP8: tl.constexpr,
+):
